// core/config.h.in — compile-time capacity ceilings, generated by CMake.
//
// The "fixed capacity, no config machinery" invariant is preserved: these are
// compile-time constants chosen per target at configure time, not runtime
// knobs. A desktop build keeps the defaults; a device build (Pi Zero W,
// ESP32) must size them to the specific models it ships — see the port docs.
//
// Do not edit the generated copy. Change the cache variables in CMakeLists.txt
// (FERRITE_MAX_DIMS, FE_MAX_NODES, FE_MAX_TENSORS, FE_MAX_ALLOCS) or your
// toolchain preset instead. The committed core/config.h holds the same
// defaults for the Makefile (non-CMake) build path.
#ifndef FERRITE_CONFIG_H
#define FERRITE_CONFIG_H

#define FERRITE_MAX_DIMS @FERRITE_MAX_DIMS@    /* tensor rank ceiling       */
#define FE_MAX_NODES     @FE_MAX_NODES@        /* graph node ceiling        */
#define FE_MAX_TENSORS   @FE_MAX_TENSORS@      /* tensor registry ceiling   */
#define FE_MAX_ALLOCS    @FE_MAX_ALLOCS@       /* planner allocation ceiling */
#define FERRITE_PLANNER_ALIGN @FERRITE_PLANNER_ALIGN@  /* activation-buffer
                                   * alignment: 64 for SIMD backends, natural
                                   * scalar alignment (4) when none is active */

#endif // FERRITE_CONFIG_H